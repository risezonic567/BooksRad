# Copy to .env.local and fill values. Never commit .env.local.

FLIGHT_SEARCH_TOKEN=

# --- Nodemailer / SMTP ---
# SMTP_PROVIDER picks host:
#   godaddy → smtpout.secureserver.net
#   titan   → smtp.titan.email
#   gmail   → smtp.gmail.com
SMTP_PROVIDER=titan
# SMTP_PROVIDER=godaddy
# SMTP_PROVIDER=gmail

# Optional override (else host comes from SMTP_PROVIDER):
# SMTP_HOST=smtp.titan.email
# SMTP_HOST=smtpout.secureserver.net
# SMTP_HOST=smtp.gmail.com

SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Usually same mailbox as SMTP_USER for Titan:
MAIL_FROM=info@booksrad.com
# Where quote/contact emails are delivered:
MAIL_TO=

NEXT_PUBLIC_SITE_URL=http://localhost:3000
